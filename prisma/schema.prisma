generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SISWA
  ADMIN
  KEPSEK
}
enum TrackType {
  DOMISILI
  PRESTASI
  AFIRMASI
  MUTASI
}
enum RegistrationStatus {
  DRAF
  MENUNGGU_VERIFIKASI
  PERLU_PERBAIKAN
  TERVERIFIKASI
  MENGIKUTI_SELEKSI
  DITERIMA
  DITOLAK
  CADANGAN
}
enum DocumentType {
  KARTU_KELUARGA
  AKTA_KELAHIRAN
  RAPOR
  IJAZAH
  SURAT_AFFIRMASI
  BUKTI_PRESTASI
  SURAT_MUTASI
  PAS_FOTO
  LAINNYA
}
enum ReviewStatus {
  MENUNGGU
  DITERIMA
  DITOLAK
  PERLU_PERBAIKAN
}
enum InvoiceStatus {
  BELUM_DIBAYAR
  MENUNGGU
  LUNAS
  KADALUWARSA
  DIBATALKAN
}
enum PaymentStatus {
  MENUNGGU
  BERHASIL
  GAGAL
  DIKEMBALIKAN
}
enum QuestionType {
  PILIHAN_GANDA
  ESAI
}
enum TestSessionStatus {
  DRAF
  TERJADWAL
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}
enum SelectionVersionStatus {
  DRAF
  TERBIT
  DIBATALKAN
}
enum SelectionStatus {
  DITERIMA
  DITOLAK
  CADANGAN
}
enum AnnouncementType {
  UMUM
  JADWAL
  HASIL
  PEMBAYARAN
}
enum NotificationStatus {
  MENUNGGU
  TERKIRIM
  GAGAL
}
enum ExportStatus {
  MENUNGGU
  DIPROSES
  SELESAI
  GAGAL
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(SISWA)
  emailVerifiedAt DateTime?
  image          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student?
  registrationDraft RegistrationDraft?
  announcements  AnnouncementRead[]
  notifications  Notification[]
  exports        ReportExport[]
  auditLogs      AuditLog[]
  documentReviews DocumentReview[]
  selectionVersions SelectionVersion[]

  @@index([role, isActive])
}

model RegistrationDraft {
  id            String   @id @default(cuid())
  userId        String   @unique
  data          Json     @default("{}")
  savedSections String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademicPeriod {
  id          String   @id @default(cuid())
  name        String   @unique
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  tracks      Track[]
  registrations Registration[]
  announcements Announcement[]
  testSessions TestSession[]
  selectionVersions SelectionVersion[]
  paymentSetting PaymentSetting?

  @@index([isActive, startsAt])
}

model Track {
  id               String     @id @default(cuid())
  academicPeriodId String
  type             TrackType
  name             String
  quota            Int
  description      String?
  isActive         Boolean    @default(true)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  registrations    Registration[]
  eligibilityRules EligibilityRule[]

  @@unique([academicPeriodId, type])
  @@index([academicPeriodId, isActive])
}

model Student {
  id             String   @id @default(cuid())
  userId         String?  @unique
  fullName       String
  nationalId     String?  @unique
  nisn           String?  @unique
  birthPlace     String?
  birthDate      DateTime?
  gender         String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  registration   Registration?
  guardians      ParentGuardian[]
  schoolOrigin   SchoolOrigin?
  reportGrades   ReportGrade[]

  @@index([fullName])
}

model Registration {
  id               String @id @default(cuid())
  registrationNo   String @unique
  studentId        String @unique
  academicPeriodId String
  trackId          String
  status           RegistrationStatus @default(DRAF)
  submittedAt      DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  track            Track @relation(fields: [trackId], references: [id], onDelete: Restrict)
  documents        Document[]
  invoices         Invoice[]
  testParticipants TestParticipant[]
  selectionResults SelectionResult[]

  @@index([academicPeriodId, status])
  @@index([trackId, status, createdAt])
}

model RegistrationSequence {
  year  Int @id
  value Int @default(0)
}

model ParentGuardian {
  id           String @id @default(cuid())
  studentId    String
  name         String
  relationship String
  phone        String?
  email        String?
  occupation   String?
  isPrimary    Boolean @default(false)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, isPrimary])
}

model SchoolOrigin {
  id          String @id @default(cuid())
  studentId   String @unique
  name        String
  npsn        String?
  address     String?
  city        String?
  graduationYear Int?
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ReportGrade {
  id          String @id @default(cuid())
  studentId   String
  subject     String
  semester    Int
  schoolYear  String
  score       Decimal @db.Decimal(5, 2)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, semester, schoolYear])
  @@index([studentId, schoolYear])
}

model Document {
  id             String @id @default(cuid())
  registrationId String
  type           DocumentType
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  encryptionIv   String
  encryptionTag  String
  uploadedAt     DateTime @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviews        DocumentReview[]

  @@index([registrationId, type])
}

model DocumentReview {
  id          String @id @default(cuid())
  documentId  String
  reviewerId  String
  status      ReviewStatus
  note        String?
  reviewedAt  DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer    User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([documentId, reviewedAt])
  @@index([reviewerId, status])
}

model Invoice {
  id             String @id @default(cuid())
  registrationId String
  invoiceNo      String @unique
  amount         Decimal @db.Decimal(12, 2)
  status         InvoiceStatus @default(BELUM_DIBAYAR)
  dueAt          DateTime?
  createdAt      DateTime @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([registrationId, status])
  @@index([status, dueAt])
}

model Payment {
  id              String @id @default(cuid())
  invoiceId       String
  provider        String
  providerRef     String? @unique
  amount          Decimal @db.Decimal(12, 2)
  status          PaymentStatus @default(MENUNGGU)
  paidAt          DateTime?
  rawResponse     Json?
  createdAt       DateTime @default(now())
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

model PaymentSetting {
  id             String @id @default(cuid())
  academicPeriodId String @unique
  amount         Decimal @db.Decimal(12, 2)
  currency       String @default("IDR")
  isEnabled      Boolean @default(false)
  updatedAt      DateTime @updatedAt
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id            String @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  instructions  String?
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())

  @@index([isActive])
}

model QuestionCategory {
  id        String @id @default(cuid())
  name      String @unique
  questions Question[]
}

model Question {
  id          String @id @default(cuid())
  categoryId  String
  type        QuestionType @default(PILIHAN_GANDA)
  prompt      String
  explanation String?
  points      Decimal @default(1) @db.Decimal(6, 2)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  category    QuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options     QuestionOption[]
  answers     TestAnswer[]
  packages    TestPackageQuestion[]

  @@index([categoryId, isActive])
}

model QuestionOption {
  id          String @id @default(cuid())
  questionId  String
  label       String
  content     String
  isCorrect   Boolean @default(false)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     TestAnswer[]

  @@unique([questionId, label])
  @@index([questionId])
}

model TestPackage {
  id          String @id @default(cuid())
  name        String
  description String?
  durationMin Int
  isActive    Boolean @default(true)
  questions   TestPackageQuestion[]
  sessions    TestSession[]
}

model TestPackageQuestion {
  packageId  String
  questionId String
  order      Int
  testPackage TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([packageId, questionId])
  @@unique([packageId, order])
}

model TestSession {
  id               String @id @default(cuid())
  academicPeriodId String
  packageId        String
  title            String
  startsAt         DateTime
  endsAt           DateTime
  status           TestSessionStatus @default(DRAF)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  testPackage      TestPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  participants    TestParticipant[]

  @@index([academicPeriodId, startsAt, status])
}

model TestParticipant {
  id             String @id @default(cuid())
  sessionId      String
  registrationId String
  startedAt      DateTime?
  submittedAt    DateTime?
  session        TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registration  Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  answers        TestAnswer[]
  result         TestResult?

  @@unique([sessionId, registrationId])
  @@index([registrationId])
}

model TestAnswer {
  id           String @id @default(cuid())
  participantId String
  questionId   String
  optionId     String?
  answerText   String?
  isFlagged    Boolean @default(false)
  isCorrect    Boolean?
  pointsEarned Decimal? @db.Decimal(6, 2)
  answeredAt   DateTime @updatedAt
  participant  TestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option       QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([participantId, questionId])
  @@index([questionId])
}

model TestResult {
  id            String @id @default(cuid())
  participantId String @unique
  score         Decimal @db.Decimal(8, 2)
  maxScore      Decimal @db.Decimal(8, 2)
  gradedAt      DateTime @default(now())
  participant   TestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model EligibilityRule {
  id          String @id @default(cuid())
  trackId     String
  name        String
  field       String
  operator    String
  value       Json
  isRequired  Boolean @default(true)
  track       Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model SelectionVersion {
  id               String @id @default(cuid())
  academicPeriodId String
  version          Int
  status           SelectionVersionStatus @default(DRAF)
  notes            String?
  createdById      String
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  createdBy        User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  results          SelectionResult[]

  @@unique([academicPeriodId, version])
  @@index([academicPeriodId, status])
}

model SelectionResult {
  id                 String @id @default(cuid())
  selectionVersionId String
  registrationId     String
  status             SelectionStatus
  score              Decimal? @db.Decimal(8, 2)
  rank               Int?
  note               String?
  selectionVersion   SelectionVersion @relation(fields: [selectionVersionId], references: [id], onDelete: Cascade)
  registration       Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([selectionVersionId, registrationId])
  @@index([selectionVersionId, status, rank])
}

model Announcement {
  id               String @id @default(cuid())
  academicPeriodId String?
  title            String
  body             String
  type             AnnouncementType @default(UMUM)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  reads            AnnouncementRead[]
  attachments      AnnouncementAttachment[]

  @@index([publishedAt, type])
}

model AnnouncementAttachment {
  id             String @id @default(cuid())
  announcementId String
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId, readAt])
}

model Notification {
  id          String @id @default(cuid())
  userId      String
  title       String
  body        String
  status      NotificationStatus @default(MENUNGGU)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model ReportExport {
  id          String @id @default(cuid())
  requestedById String
  name        String
  format      String
  status      ExportStatus @default(MENUNGGU)
  fileUrl     String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  requestedBy User @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
}

model AuditLog {
  id         String @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([action, createdAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  email     String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  email     String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}