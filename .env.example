# Neon PostgreSQL: pooled URL for runtime and direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Neon Object Storage (S3-compatible; bucket "uploads" must be private)
AWS_ENDPOINT=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="SPMB SMPN 9 Depok <noreply@example.com>"

# Payment gateway (server key must never be exposed to the browser)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Optional rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Demo account password used only by prisma/seed.ts
DEMO_PASSWORD=""